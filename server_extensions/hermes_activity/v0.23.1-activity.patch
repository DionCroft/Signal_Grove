+def _metadata_reporter(callback, tool_name: str, tool_call_id: str):
+    if callback is None or not tool_call_id:
+        return None
+    lock = threading.Lock()
+    reported: set[str] = set()
+
+    def report(identity: str) -> None:
+        if (not isinstance(identity, str) or not identity.strip()
+                or len(identity) > 256 or not identity.isprintable()):
+            return
+        with lock:
+            if identity in reported:
+                return
+            reported.add(identity)
+        try:
+            callback(tool_name, tool_call_id, identity)
+        except Exception:  # health: allow BLE001 -- an observation cannot fail the actual tool call
+            logger.debug("Tool activity metadata callback failed", exc_info=False)
+    return report
+
+
+def current_mcp_origin() -> Optional[Callable[[str], None]]:
+    """The call-scoped, metadata-only observer captured by the selected MCP handler."""
+    return _mcp_origin.get()
+
+
+def current_skill_loaded() -> Optional[Callable[[str], None]]:
+    """The call-scoped observer for a successful full skill view."""
+    return _skill_loaded.get()


